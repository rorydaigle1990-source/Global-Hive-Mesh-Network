<div class="container" style="margin-top: 30px; border-color: var(--hive-gold);">
    <h2 style="color: var(--hive-gold); text-transform: uppercase; letter-spacing: 2px;">The V4 Reactor Test</h2>
    <p style="font-size: 0.9rem; color: #ccc;">PROVE THE PHYSICS: Remove the "Drag" (Bank Fees) to ignite the V4 Velocity.</p>

    <div id="reactor-core" style="
        width: 100px; 
        height: 100px; 
        border-radius: 50%; 
        border: 5px solid #333; 
        margin: 20px auto; 
        box-shadow: 0 0 10px #333;
        display: flex; align-items: center; justify-content: center;
        transition: all 0.2s ease;
    ">
        <div id="core-text" style="font-weight: bold; font-size: 1.5rem;">0%</div>
    </div>

    <div style="text-align: left; margin-top: 20px;">
        <label>SYSTEM DRAG (BANK FEES): <span id="drag-val" style="color: red;">3.0%</span></label>
        <input type="range" id="drag-slider" min="0" max="3" step="0.1" value="3" style="width: 100%; accent-color: red;" oninput="updatePhysics()">
        
        <div style="display: flex; justify-content: space-between; margin-top: 5px; font-size: 0.7rem; color: #666;">
            <span>YOUR SYSTEM (0%)</span>
            <span>OLD BANKS (3%)</span>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 20px;">
        <div style="background: rgba(255,0,0,0.1); padding: 10px; border: 1px solid #550000;">
            <div style="font-size: 0.7rem; color: #aaa;">WASTED WEALTH</div>
            <div id="waste-display" style="font-size: 1.2rem; color: #ff4444;">$30,000</div>
        </div>
        <div style="background: rgba(0,255,0,0.1); padding: 10px; border: 1px solid #005500;">
            <div style="font-size: 0.7rem; color: #aaa;">SYNTHETIC YIELD (JOBS)</div>
            <div id="yield-display" style="font-size: 1.2rem; color: #00ff00;">$0</div>
        </div>
    </div>

    <div id="physics-message" style="margin-top: 15px; font-style: italic; color: #888;">
        System is clogged by fees. Velocity is dead.
    </div>
</div>

<script>
    function updatePhysics() {
        // 1. GET INPUTS
        let drag = parseFloat(document.getElementById('drag-slider').value);
        let mass = 1000000; // Simulating $1M moving through the economy
        
        // 2. THE PHYSICS MATH (Simplified V4 Logic)
        // If Drag is high, Velocity is low (1x). If Drag is 0, Velocity is V^4 (Simulated as 10x for visual).
        let velocity = 1 + (3 - drag) * 3; // 3.0 drag = 1x speed. 0.0 drag = 10x speed.
        
        // waste = Mass * (Drag / 100) * velocity cycles
        let waste = mass * (drag / 100) * 10; 
        
        // yield = (Mass * Velocity Multiplier) - Waste
        let syntheticYield = (mass * velocity * 0.5) - waste;
        if (syntheticYield < 0) syntheticYield = 0;

        // 3. UPDATE VISUALS
        document.getElementById('drag-val').innerText = drag.toFixed(1) + "%";
        document.getElementById('waste-display').innerText = "$" + Math.floor(waste).toLocaleString();
        document.getElementById('yield-display').innerText = "$" + Math.floor(syntheticYield).toLocaleString();

        // 4. ANIMATE REACTOR CORE
        const core = document.getElementById('reactor-core');
        const coreText = document.getElementById('core-text');
        
        if (drag > 0.5) {
            // THE "OLD SYSTEM" (Red, Slow, Stuck)
            core.style.borderColor = "red";
            core.style.boxShadow = "0 0 10px red";
            core.style.animation = `spin ${5/velocity}s linear infinite`; // Slow spin
            coreText.innerText = "DRAG";
            coreText.style.color = "red";
            document.getElementById('physics-message').innerText = "FATAL ERROR: Fees are eating the principal. No growth possible.";
            document.getElementById('physics-message').style.color = "#ff4444";
        } else {
            // THE "HIVE SYSTEM" (Blue/Gold, Hyper-Speed)
            core.style.borderColor = "#00f3ff";
            core.style.boxShadow = "0 0 50px #00f3ff";
            core.style.animation = `spin 0.2s linear infinite`; // Hyper speed
            coreText.innerText = "V4";
            coreText.style.color = "#00f3ff";
            document.getElementById('physics-message').innerText = "OPTIMAL STATE: Friction removed. Infinite Velocity achieved.";
            document.getElementById('physics-message').style.color = "#00ff00";
        }
    }
    
    // Add Spin Animation style dynamically
    const styleSheet = document.createElement("style");
    styleSheet.innerText = `
        @keyframes spin { 100% { transform: rotate(360deg); } }
    `;
    document.head.appendChild(styleSheet);

    // Initialize
    updatePhysics();
</script>